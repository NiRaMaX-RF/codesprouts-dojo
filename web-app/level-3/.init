#!/bin/sh

chmod 400 /challenge/plaintext

mkdir -p /data/db
mongod &

sed -i 's/fetch(uw/fetch(location.pathname/g' /challenge/package/client/static/js/main.1f941a4d.js
sed -i 's/pathname:n.pathname/pathname:n.pathname.replace(\/workspace\\\/.*:.*\\\/.*\\\/80\\\/\/g, "workspace\/challenge")/g' /challenge/package/client/static/js/main.1f941a4d.js

cd /challenge/package
ln -s /usr/lib/node_modules .
node index.js >/var/log/node.log 2>&1 &