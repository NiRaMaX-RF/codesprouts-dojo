#!/bin/sh

/challenge/replace_flag_value.sh
rm /challenge/replace_flag_value.sh

mkdir -p /data/db
mongod &

sed -i 's/"\/workspace\/challenge"/(location.pathname.match(\/^\\\/workspace\\\/.*:.*\\\/.*\\\/80\\\/\/g) ?? ["\/"])[0]/g' /challenge/package/client/static/js/main.1f941a4d.js
sed -i 's/"\/workspace\/challenge\/"/(location.pathname.match(\/^\\\/workspace\\\/.*:.*\\\/.*\\\/80\\\/\/g) ?? ["\/"])[0]/g' /challenge/package/client/static/js/main.1f941a4d.js

cd /challenge/package
ln -s /usr/lib/node_modules .
node index.js >/var/log/node.log 2>&1 &
